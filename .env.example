# System Environment
PROJECT_NAME="Multimodal & Cross-Lingual Semantic Plagiarism Detection Agent"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501", "http://localhost:3000"]

# File Storage & Limits
DATA_DIR="./data"
MAX_UPLOAD_SIZE_MB=25

# Model Selections (CPU-Optimized Defaults)
TEXT_EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
CODE_EMBEDDING_MODEL="microsoft/unixcoder-base"
WHISPER_MODEL="tiny"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"

# Inference Runtime
EMBEDDING_DEVICE="cpu"
EMBEDDING_BATCH_SIZE=32

# Vector Search & Reranking
DEFAULT_TOP_K=5
USE_RERANKER=False

# Detection Thresholds
THRESHOLD_DIRECT_COPY=0.88
THRESHOLD_PARAPHRASE=0.65
THRESHOLD_WEAK_SIMILARITY=0.50
THRESHOLD_LEXICAL_DIVERGENCE=0.35